{
  "manifest_version": 3,
  "name": "Open in SlideMate",
  "version": "1.0",
  "description": "Open the PDF you're viewing in SlideMate (AI tutor with full-deck context + Send to iPad).",
  "action": { "default_title": "Open this PDF in SlideMate", "default_icon": { "32": "icon32.png", "128": "icon128.png" } },
  "icons": { "32": "icon32.png", "128": "icon128.png" },
  "background": { "service_worker": "background.js" },
  "permissions": ["contextMenus", "activeTab", "notifications"],
  "host_permissions": ["<all_urls>"],
  "commands": { "_execute_action": { "suggested_key": { "default": "Alt+Shift+S", "mac": "Alt+Shift+S" } } }
}
